FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN grep -vi "torch" requirements.txt > requirements-deploy.txt \
    && pip install --no-cache-dir -r requirements-deploy.txt

COPY . .

RUN mkdir -p /home/data

ENV DATABASE_URL=sqlite:////home/data/clearrisk_recover.db
EXPOSE 8000

CMD ["/bin/sh", "-c", "[ -f /home/data/clearrisk_recover.db ] || (python scripts/seed_demo_cases.py && python scripts/seed_demo_users.py); exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
