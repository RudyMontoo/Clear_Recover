FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN grep -vi "torch" requirements.txt > requirements-deploy.txt \
    && pip install --no-cache-dir -r requirements-deploy.txt

COPY . .

EXPOSE 8000

CMD ["python", "-m", "streamlit", "run", "dashboard/streamlit_app.py", "--server.port", "8000", "--server.address", "0.0.0.0", "--server.headless", "true"]
